{
  "name": "lore",
  "description": "Workflow and knowledge layer for teams coding with Claude Code \u2014 small repo-scoped context at session start, facts filed where they have a reader (issues, PRs, ADRs, team wiki, logbook), the rest pulled on demand over MCP. Ships the build skills too: orient, grilling, to-epic, build, tdd, debug, document, experiment, handover, file-issue, triage.",
  "version": "0.100.1",
  "author": {
    "name": "Christof Buchbender"
  },
  "homepage": "https://github.com/buchbend/lore",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "mcp",
    "rag"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook capture --event session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook pre-compact"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook capture --event pre-compact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook user-prompt-submit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook capture --event session-end"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook token-usage"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lore hook stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "lore hook spawn-model-gate"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "lore": {
      "command": "lore",
      "args": [
        "mcp"
      ]
    }
  }
}
